# Neon pooled connection URL (runtime)
DATABASE_URL=

# Neon direct connection URL (migrations)
DIRECT_URL=

# HTTP server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Server-only LLM scenario generation. Never expose GENERATION_ACCESS_KEY to a client bundle.
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
GENERATION_CONCURRENCY=1
GENERATION_ACCESS_KEY=
GENERATION_MAX_COST_NANO_USD=500000000
GENERATION_DAILY_BUDGET_NANO_USD=3000000000
