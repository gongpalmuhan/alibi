generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Phase {
  lobby
  reading
  investigation
  discussion
  voting
  reveal
}

enum GenerationStatus {
  queued
  generating
  ready
  failed
}

enum ScenarioSource {
  PRESET
  GENERATED
}

model Room {
  id               String           @id @default(cuid())
  code             String           @unique
  theme            String
  playerCount      Int
  phase            Phase            @default(lobby)
  scenarioId       String?
  generationStatus GenerationStatus @default(queued)
  generationStep   String?
  generationError  String?
  hostTokenHash    String
  createdAt        DateTime         @default(now())

  scenario Scenario? @relation(fields: [scenarioId], references: [id])
  players  Player[]
  votes    Vote[]
  generationAttempts GenerationAttempt[]
}

model Player {
  id               String   @id @default(cuid())
  roomId           String
  nickname         String
  characterId      String?
  sessionTokenHash String   @unique
  joinedAt         DateTime @default(now())

  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  votes Vote[]
}

model Scenario {
  id          String   @id @default(cuid())
  theme       String
  playerCount Int
  data        Json
  source      ScenarioSource @default(PRESET)
  createdAt   DateTime @default(now())

  rooms              Room[]
  generationAttempts GenerationAttempt[]
}

model GenerationAttempt {
  id               String           @id @default(cuid())
  roomId           String
  scenarioId       String?
  status           GenerationStatus @default(queued)
  step             String?
  model            String
  reservedNanoUsd  BigInt
  actualNanoUsd    BigInt?
  inputTokens      Int?
  cachedInputTokens Int?
  outputTokens     Int?
  errorCode        String?
  createdAt        DateTime         @default(now())
  completedAt      DateTime?

  room     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scenario Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
}

model GenerationBudget {
  /// UTC calendar day, normalized to midnight.
  date             DateTime @id
  reservedNanoUsd  BigInt   @default(0)
  spentNanoUsd     BigInt   @default(0)
}

model Vote {
  id                String   @id @default(cuid())
  roomId            String
  voterId           String
  targetCharacterId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  voter Player @relation(fields: [voterId], references: [id])

  @@unique([roomId, voterId])
}
